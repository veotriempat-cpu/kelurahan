rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN AUTHORIZATION
    // Root collection: /admins/{UID}
    // Document ID must equal the Firebase Authentication UID.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Public website configuration may be read before login so that
    // logo, photos and card colors appear on every device. Only an
    // authenticated user may write it.
    match /artifacts/{appId}/public/data/settings/webSettings {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // All other application data requires an authenticated Firebase user.
    match /artifacts/{appId}/public/data/{collection}/{document} {
      allow read, write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/{collection}/{document}/{subcollection}/{subdocument} {
      allow read, write: if request.auth != null;
    }
  }
}
