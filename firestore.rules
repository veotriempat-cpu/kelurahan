rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/public/data/settings/webSettings {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public aggregate-only statistics. No personal resident fields are stored here.
    match /artifacts/{appId}/public/data/publicStats/summary {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/settings/{document} {
      allow read, write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/{collection}/{document} {
      allow read, write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/{collection}/{document}/{subcollection}/{subdocument} {
      allow read, write: if request.auth != null;
    }
  }
}
