rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ADMIN AUTHORIZATION
    // Root collection: /admins/{UID}
    // Document ID HARUS sama dengan Firebase Authentication UID.
    // Password TIDAK disimpan di Firestore.
    // ============================================================
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // ============================================================
    // PUBLIC WEBSITE BRANDING
    // Logo, foto pimpinan, warna kartu, teks landing, TTD/stempel config.
    // Visitor harus dapat MEMBACA agar landing page tampil di PC/HP lain.
    // Hanya user terautentikasi yang dapat menulis.
    // ============================================================
    match /artifacts/{appId}/public/data/settings/webSettings {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Data aplikasi lama tetap berada di namespace artifacts.
    // Akses hanya untuk user yang sudah authenticated.
    match /artifacts/{appId}/public/data/{collection}/{document} {
      allow read, write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/{collection}/{document}/{subcollection}/{subdocument} {
      allow read, write: if request.auth != null;
    }
  }
}
