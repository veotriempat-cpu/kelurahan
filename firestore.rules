rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // ADMIN AUTHORIZATION
    // ==========================================================
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // ==========================================================
    // PUBLIC WEBSITE CONFIGURATION
    // Semua perangkat boleh membaca. Hanya user authenticated
    // yang boleh menulis dari aplikasi.
    // ==========================================================
    match /artifacts/{appId}/public/data/settings/webSettings {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ==========================================================
    // PUBLIC CONTENT
    // Agenda, UMKM, Bursa, Fasilitas, dan Galeri dibaca publik.
    // Penulisan tetap hanya user authenticated.
    // ==========================================================
    match /artifacts/{appId}/public/data/agenda/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/umkm/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/bursa/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/fasilitas/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/galeri/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ==========================================================
    // LEGACY / PRIVATE DATA
    // ==========================================================
    match /artifacts/{appId}/public/data/{collection}/{document} {
      allow read, write: if request.auth != null;
    }

    match /artifacts/{appId}/public/data/{collection}/{document}/{subcollection}/{subdocument} {
      allow read, write: if request.auth != null;
    }
  }
}
