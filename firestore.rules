rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // ADMIN AUTHORIZATION
    // /admins/{UID}
    // ==========================================================
    match /admins/{uid} {
      // Admin hanya boleh membaca dokumen admin miliknya sendiri.
      allow read: if request.auth != null
                  && request.auth.uid == uid;

      // Tidak boleh membuat/mengubah/menghapus dari client.
      allow create, update, delete: if false;
    }

    // ==========================================================
    // PUBLIC WEBSITE SETTINGS
    // Logo, foto Walikota/Wakil/Camat/Lurah,
    // warna kartu, nama website, header, footer, TTD, stempel.
    // ==========================================================
    match /artifacts/{appId}/public/data/settings/webSettings {

      // Semua perangkat boleh membaca konfigurasi website.
      allow read: if true;

      // Hanya user yang sudah login yang boleh menyimpan.
      allow write: if request.auth != null;
    }

    // ==========================================================
    // SETTINGS LAIN
    // ==========================================================
    match /artifacts/{appId}/public/data/settings/{document} {

      // Hanya user authenticated.
      allow read, write: if request.auth != null;
    }

    // ==========================================================
    // DATA APLIKASI
    // ==========================================================
    match /artifacts/{appId}/public/data/{collection}/{document} {

      allow read, write: if request.auth != null;
    }

    // ==========================================================
    // SUBCOLLECTION
    // ==========================================================
    match /artifacts/{appId}/public/data/{collection}/{document}/{subcollection}/{subdocument} {

      allow read, write: if request.auth != null;
    }
  }
}
